---
import { negocio, whatsappPadrao } from '../data/conteudo';

const whatsIcon =
  'M20.5 3.5A10.4 10.4 0 0 0 3.6 16.2L2.5 21.5l5.4-1.1A10.4 10.4 0 1 0 20.5 3.5Z';
---

<!-- Desktop: botão flutuante -->
<a
  class="wa-float"
  href={whatsappPadrao}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d={whatsIcon}></path>
    <path d="M8.6 9.2c0 3.2 2.9 6.1 6.1 6.1.6 0 1.2-.4 1.4-1l-2-1-.9.9c-1.1-.5-2-1.4-2.5-2.5l.9-.9-1-2c-.6.2-1 .8-1 1.4Z"></path>
  </svg>
  <span>WhatsApp</span>
</a>

<!-- Mobile: barra fixa com ligar + WhatsApp -->
<div class="wa-bar">
  <a class="wa-bar__btn wa-bar__btn--call" href={`tel:+${negocio.whatsappNumero}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path
        d="M5 3h3l1.6 4-2 1.4a12 12 0 0 0 5.9 5.9l1.4-2 4 1.6v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 5.2 2 2 0 0 1 5 3Z"
      ></path>
    </svg>
    Ligar
  </a>
  <a class="wa-bar__btn wa-bar__btn--wa" href={whatsappPadrao} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d={whatsIcon}></path>
    </svg>
    WhatsApp
  </a>
</div>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 80;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--brand-green);
    color: var(--ink-dark);
    font-weight: 700;
    font-size: 0.875rem;
    box-shadow: 0 0.75rem 2rem -0.5rem rgba(147, 188, 30, 0.5);
    animation: wa-pulse 3s var(--ease-in-out) infinite;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .wa-float svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes wa-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.045);
    }
  }

  .wa-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1px;
    background: var(--hairline);
    border-top: 1px solid var(--hairline);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .wa-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .wa-bar__btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .wa-bar__btn--call {
    background: var(--bg-elevated);
    color: var(--ink);
  }

  .wa-bar__btn--wa {
    background: var(--brand-green);
    color: var(--ink-dark);
  }

  :global(body) {
    padding-bottom: 3.25rem;
  }

  @media (min-width: 769px) {
    .wa-float {
      display: inline-flex;
    }
    .wa-bar {
      display: none;
    }
    :global(body) {
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
  }
</style>
