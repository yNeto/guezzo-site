---
import { planos, diaria, regras } from '../data/conteudo';
---

<section class="section section--light" id="planos">
  <div class="shell">
    <div class="section-head">
      <h2 class="display display--lg" data-reveal-lines>
        <span data-reveal-line><span>Planos sem</span></span>
        <span data-reveal-line><span>letra miúda.</span></span>
      </h2>
      <p class="lede" data-reveal>
        Todos com acesso 24 horas e todas as modalidades. Matriculando com amigo, familiar
        ou como estudante, o valor por pessoa cai para R$ 120.
      </p>
    </div>

    <ul class="planos">
      {
        planos.map((plano, i) => (
          <li
            class:list={['plano', { 'plano--destaque': plano.destaque }]}
            data-reveal
            data-reveal-delay={i * 0.06}
          >
            {plano.destaque && <span class="plano__selo">Mais completo</span>}
            <h3 class="plano__nome">{plano.nome}</h3>
            <p class="plano__preco">
              {plano.preco}
              <small>{plano.periodo}</small>
            </p>
            <p class="plano__detalhe">{plano.detalhe}</p>
            <ul class="plano__lista">
              {plano.beneficios.map((b) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                  {b}
                </li>
              ))}
            </ul>
            <button
              class:list={['btn', 'btn--block', plano.destaque ? 'btn--primary' : 'btn--ghost']}
              data-modal-open={plano.nome}
            >
              Quero esse plano
            </button>
          </li>
        ))
      }
    </ul>

    <div class="diaria" data-reveal>
      <div>
        <p class="eyebrow">{diaria.nome}</p>
        <p class="diaria__texto">{diaria.detalhe}</p>
      </div>
      <p class="diaria__preco">{diaria.preco}</p>
      <button class="btn btn--primary" data-modal-open={diaria.nome}>
        Quero a diária
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <div class="regras" data-reveal>
      <h3 class="regras__titulo">Regras e funcionamento</h3>
      {
        regras.map((regra) => (
          <details class="regra">
            <summary>
              {regra.pergunta}
              <i aria-hidden="true" />
            </summary>
            <p>{regra.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .planos {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
  }

  @media (max-width: 560px) {
    .planos {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .plano {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.75rem 1.375rem;
    background: #fff;
    border: 1px solid var(--hairline-dark);
    border-radius: var(--radius-card);
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .plano--destaque {
    background: var(--ink-dark);
    color: var(--ink);
    border-color: var(--brand-green);
  }

  .plano__selo {
    position: absolute;
    top: -0.7rem;
    left: 1.375rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--brand-green);
    color: var(--ink-dark);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .plano__nome {
    font-size: 1.25rem;
  }

  .plano__preco {
    font-family: 'Anton', sans-serif;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1;
  }

  .plano--destaque .plano__preco {
    color: var(--brand-green);
  }

  .plano__preco small {
    display: block;
    font-family: 'Inter Variable', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-dark-soft);
    margin-top: 0.3rem;
  }

  .plano--destaque .plano__preco small {
    color: var(--ink-soft);
  }

  .plano__detalhe {
    font-size: 0.8125rem;
    color: var(--ink-dark-soft);
  }

  .plano--destaque .plano__detalhe {
    color: var(--ink-soft);
  }

  .plano__lista {
    display: grid;
    gap: 0.45rem;
    margin: 0.75rem 0 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .plano__lista li {
    display: grid;
    grid-template-columns: 1rem 1fr;
    gap: 0.5rem;
    align-items: start;
  }

  .plano__lista svg {
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    color: #6d8c12;
  }

  .plano--destaque .plano__lista svg {
    color: var(--brand-green);
  }

  .plano .btn {
    margin-top: auto;
  }

  .plano--destaque .btn--ghost {
    border-color: var(--hairline);
    color: var(--ink);
  }

  /* --- diária --- */
  .diaria {
    display: grid;
    gap: 1rem;
    align-items: center;
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px dashed rgba(11, 12, 10, 0.28);
    border-radius: var(--radius-card);
  }

  @media (min-width: 800px) {
    .diaria {
      grid-template-columns: 1fr auto auto;
      gap: 2rem;
    }
  }

  .diaria__texto {
    font-size: 0.9375rem;
    color: var(--ink-dark-soft);
  }

  .diaria__preco {
    font-family: 'Anton', sans-serif;
    font-size: 2rem;
    line-height: 1;
  }

  /* --- regras --- */
  .regras {
    margin-top: 3.5rem;
    max-width: 52rem;
  }

  .regras__titulo {
    font-size: 1.125rem;
    margin-bottom: 1rem;
  }

  .regra {
    border-top: 1px solid var(--hairline-dark);
  }

  .regra:last-child {
    border-bottom: 1px solid var(--hairline-dark);
  }

  .regra summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }

  .regra summary::-webkit-details-marker {
    display: none;
  }

  .regra summary i {
    position: relative;
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
  }

  .regra summary i::before,
  .regra summary i::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .regra summary i::after {
    transform: rotate(90deg);
  }

  .regra[open] summary i::after {
    transform: rotate(0deg);
  }

  .regra p {
    padding-bottom: 1.125rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-dark-soft);
    max-width: 60ch;
  }

  @media (hover: hover) and (min-width: 769px) {
    .plano:hover {
      transform: translateY(-6px);
      box-shadow: 0 1.5rem 3rem -1.5rem rgba(11, 12, 10, 0.35);
    }
    .plano--destaque:hover {
      box-shadow: var(--glow-green-on);
    }
    .regra summary:hover {
      color: #6d8c12;
    }
  }
</style>
