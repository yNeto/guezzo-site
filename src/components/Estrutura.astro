---
import { Image } from 'astro:assets';
import { estrutura } from '../data/conteudo';
---

<section class="section" id="estrutura">
  <div class="shell">
    <div class="section-head">
      <h2 class="display display--lg" data-reveal-lines>
        <span data-reveal-line><span>Estrutura de</span></span>
        <span data-reveal-line><span>quem leva a sério.</span></span>
      </h2>
      <p class="lede" data-reveal>
        Climatizada, com equipamento novo e espaço de sobra para treinar sem esperar
        aparelho, a qualquer hora do dia ou da noite.
      </p>
    </div>

    <div class="estrutura__grid">
      {
        estrutura.map((item, i) => (
          <figure class="card-tilt" data-reveal data-reveal-delay={i * 0.1} style={`--tilt:${i % 2 === 0 ? -2.2 : 2.2}deg`}>
            <div class="card-tilt__media">
              <Image
                src={item.foto}
                alt={item.titulo}
                width={1200}
                height={900}
                loading="lazy"
                data-parallax="6"
              />
            </div>
            <figcaption class="card-tilt__cap">
              <strong>{item.titulo}</strong>
              <span>{item.texto}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .estrutura__grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 800px) {
    .estrutura__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .card-tilt {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline);
    transform: rotate(var(--tilt));
    transition:
      transform var(--dur-slow) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .card-tilt__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .card-tilt__media :global(img) {
    width: 100%;
    height: 118%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.9);
  }

  .card-tilt::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 12, 10, 0.92) 8%,
      rgba(11, 12, 10, 0.1) 55%,
      rgba(15, 47, 20, 0.3) 100%
    );
    pointer-events: none;
  }

  .card-tilt__cap {
    position: absolute;
    z-index: 1;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(10px);
  }

  .card-tilt__cap strong {
    font-size: 0.9375rem;
  }

  .card-tilt__cap span {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  @media (hover: hover) and (min-width: 769px) {
    .card-tilt:hover {
      transform: rotate(0deg) scale(1.02);
      border-color: rgba(147, 188, 30, 0.5);
    }
  }
</style>
