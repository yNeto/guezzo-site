---
// Cortina de abertura: logo em reveal de clip + barra de progresso verde.
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader__inner">
    <div class="loader__logo">
      <img src="/logo-guezzo.png" alt="" width="420" height="140" />
    </div>
    <div class="loader__bar"><span data-loader-bar></span></div>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--bg);
    transition: clip-path 850ms cubic-bezier(0.65, 0, 0.35, 1);
    clip-path: inset(0 0 0% 0);
  }

  .loader.is-done {
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }

  .loader__inner {
    display: grid;
    gap: 1.75rem;
    justify-items: center;
    width: min(22rem, 70vw);
  }

  .loader__logo {
    clip-path: inset(100% 0 0 0);
    animation: logo-reveal 900ms cubic-bezier(0.16, 1, 0.3, 1) 120ms forwards;
  }

  .loader__logo img {
    width: 100%;
    height: auto;
  }

  @keyframes logo-reveal {
    to {
      clip-path: inset(0% 0 0 0);
    }
  }

  .loader__bar {
    width: 100%;
    height: 2px;
    background: var(--hairline);
    overflow: hidden;
  }

  .loader__bar span {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--brand-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      display: none;
    }
    .loader__logo {
      animation: none;
      clip-path: none;
    }
  }
</style>

<script>
  const MIN_VISIBLE = 1400;
  const EXIT = 850;

  const loader = document.querySelector<HTMLElement>('[data-loader]');
  const bar = document.querySelector<HTMLElement>('[data-loader-bar]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const easeInOutCubic = (t: number): number =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  if (!loader || reduced) {
    loader?.remove();
    document.body.classList.remove('is-locked');
  } else {
    document.body.classList.add('is-locked');
    const start = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - start) / MIN_VISIBLE, 1);
      if (bar) bar.style.width = `${easeInOutCubic(progress) * 100}%`;
      if (progress < 1) {
        requestAnimationFrame(tick);
        return;
      }
      loader.classList.add('is-done');
      document.body.classList.remove('is-locked');
      window.setTimeout(() => loader.remove(), EXIT);
    };

    requestAnimationFrame(tick);
  }
</script>
