---
import { modalidades } from '../data/conteudo';
---

<section class="section" id="modalidades">
  <div class="shell">
    <div class="section-head">
      <h2 class="display display--lg" data-reveal-lines>
        <span data-reveal-line><span>Tudo em um</span></span>
        <span data-reveal-line><span>só lugar.</span></span>
      </h2>
      <p class="lede" data-reveal>
        Dez modalidades incluídas no plano. Troque de treino sem trocar de academia.
      </p>
    </div>

    <p class="mods__dica" data-reveal aria-hidden="true">Arraste para o lado →</p>

    <ul class="mods">
      {
        modalidades.map((mod, i) => (
          <li class="mod" data-reveal data-reveal-delay={(i % 4) * 0.06}>
            <span class="mod__icone">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={mod.icone} />
              </svg>
            </span>
            <h3 class="mod__nome">{mod.nome}</h3>
            <p class="mod__texto">{mod.descricao}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Abaixo de 700px: trilho horizontal com swipe e snap por cartão — a lista
     de 8 modalidades não cabe empilhada sem virar um scroll infinito vertical.
     De 700px em diante volta a ser grade normal, sem scroll próprio. */
  .mods__dica {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-dim);
  }

  .mods {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 0.25rem;
  }

  .mods::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 700px) {
    .mods__dica {
      display: none;
    }
    .mods {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      scroll-snap-type: none;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1024px) {
    .mods {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .mod {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.75rem 1.375rem 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: 68%;
    max-width: 16rem;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }

  @media (min-width: 700px) {
    .mod {
      width: auto;
      max-width: none;
    }
  }

  .mod__icone {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: rgba(147, 188, 30, 0.12);
    color: var(--brand-green);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .mod__icone svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .mod__nome {
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }

  .mod__texto {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  @media (hover: hover) and (min-width: 769px) {
    .mod:hover {
      transform: translateY(-6px);
      border-color: rgba(147, 188, 30, 0.55);
      background: #171a11;
    }
    .mod:hover .mod__icone {
      transform: rotate(-8deg) scale(1.08);
    }
  }
</style>
