---
import { Image } from 'astro:assets';
import { fotos, negocio, whatsappLink } from '../data/conteudo';

const heroWhats = whatsappLink(
  'Oi! Vi o site da Guezzo TS Fit Club e quero saber mais sobre a matrícula.'
);
---

<section class="hero" id="top">
  <div class="hero__media">
    <Image
      src={fotos.hero}
      alt="Treino de musculação em ambiente escuro"
      width={1920}
      height={1280}
      loading="eager"
      fetchpriority="high"
      data-parallax="8"
    />
  </div>
  <div class="hero__scrim"></div>

  <div class="hero__content shell">
    <p class="badge24" data-reveal>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3.2 2"></path>
      </svg>
      1ª academia 24h do Recôncavo da Bahia
    </p>

    <h1 class="display display--xl hero__title" data-reveal-lines>
      <span data-reveal-line><span>Treine</span></span>
      <span data-reveal-line><span>sem horário.</span></span>
    </h1>

    <p class="lede hero__lede" data-reveal data-reveal-delay="0.15">
      A primeira academia 24 horas do Recôncavo da Bahia. Musculação, cross training,
      personal e muito mais em Cruz das Almas — no seu horário, não no nosso.
    </p>

    <div class="hero__ctas" data-reveal data-reveal-delay="0.25">
      <a class="btn btn--primary" href={heroWhats} target="_blank" rel="noopener">
        Fale no WhatsApp
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href="#planos">Ver planos</a>
    </div>

    <div class="hero__chips" data-reveal data-reveal-delay="0.35">
      <span class="chip">
        <b data-count={negocio.instagram.seguidores} data-count-suffix="+">0</b>
        seguidores
      </span>
      <span class="chip">
        <b>{negocio.google.nota} ★</b>
        {negocio.google.avaliacoes} avaliações no Google
      </span>
    </div>
  </div>

  <div class="hero__track track-line"></div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding-block: 9rem 4.5rem;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: -10% 0;
    z-index: 0;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to top,
        var(--bg) 4%,
        rgba(11, 12, 10, 0.72) 42%,
        rgba(11, 12, 10, 0.45) 100%
      ),
      linear-gradient(105deg, rgba(15, 47, 20, 0.55), rgba(11, 12, 10, 0) 62%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .badge24 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--brand-green);
    color: var(--ink-dark);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    animation: badge-glow 3.2s var(--ease-in-out) infinite;
  }

  .badge24 svg {
    width: 1rem;
    height: 1rem;
  }

  @keyframes badge-glow {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(147, 188, 30, 0);
    }
    50% {
      box-shadow: 0 0.5rem 2.25rem -0.25rem rgba(147, 188, 30, 0.6);
    }
  }

  .hero__title {
    max-width: 14ch;
  }

  .hero__lede {
    max-width: 44ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.75rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  .chip b {
    color: var(--ink);
    font-weight: 700;
  }

  .hero__track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.75rem;
    z-index: 2;
  }

  @media (min-width: 900px) {
    .hero__content {
      gap: 1.75rem;
    }
  }
</style>
