---
import { navLinks, negocio } from '../data/conteudo';
---

<header class="header" data-header>
  <div class="header__inner">
    <nav class="header__nav header__nav--left" aria-label="Seções">
      {navLinks.map((link) => <a href={link.href}>{link.rotulo}</a>)}
    </nav>

    <a class="header__logo" href="#top" aria-label={`${negocio.nome} — início`}>
      <img src="/logo-guezzo.png" alt={negocio.nome} width="360" height="120" />
    </a>

    <div class="header__actions">
      <span class="header__live" title={negocio.horario}>
        <i></i>Aberto agora
      </span>

      <button class="btn btn--primary header__cta" data-modal-open="Individual">
        Quero me matricular
      </button>

      <a
        class="header__icon"
        href={negocio.instagram.url}
        target="_blank"
        rel="noopener"
        aria-label={`Instagram ${negocio.instagram.handle}`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="3.6"></circle>
          <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>

      <button
        class="header__burger"
        data-menu-toggle
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    transition:
      background var(--dur-base) var(--ease-out),
      backdrop-filter var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .header.is-scrolled {
    background: rgba(11, 12, 10, 0.72);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--hairline);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0.875rem var(--gutter);
  }

  .header__nav {
    display: none;
    gap: 1.75rem;
    flex: 1;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .header__nav a {
    position: relative;
    color: var(--ink-soft);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    height: 1px;
    width: 100%;
    background: var(--brand-green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__logo {
    flex: 0 0 auto;
  }

  .header__logo img {
    width: 7.5rem;
    height: auto;
  }

  .header__actions {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .header__live {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .header__live i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 0 0 rgba(147, 188, 30, 0.6);
    animation: live-pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(147, 188, 30, 0.55);
    }
    70% {
      box-shadow: 0 0 0 0.55rem rgba(147, 188, 30, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(147, 188, 30, 0);
    }
  }

  .header__cta {
    display: none;
    padding: 0.7rem 1.25rem;
    font-size: 0.8125rem;
  }

  .header__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    color: var(--ink-soft);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .header__icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .header__burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
  }

  .header__burger span {
    display: block;
    width: 1.0625rem;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__burger span:last-child {
    width: 0.6875rem;
    align-self: center;
    margin-right: 0.375rem;
  }

  @media (min-width: 900px) {
    .header__nav,
    .header__cta,
    .header__live {
      display: flex;
    }
    .header__logo img {
      width: 9rem;
    }
  }

  @media (hover: hover) and (min-width: 769px) {
    .header__nav a:hover {
      color: var(--ink);
    }
    .header__nav a:hover::after {
      transform: scaleX(1);
    }
    .header__icon:hover,
    .header__burger:hover {
      color: var(--brand-green);
      border-color: var(--brand-green);
    }
  }
</style>
