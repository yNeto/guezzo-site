---
import { negocio, whatsappPadrao } from '../data/conteudo';
const { endereco } = negocio;
---

<section class="section" id="localizacao">
  <div class="shell">
    <div class="section-head">
      <h2 class="display display--lg" data-reveal-lines>
        <span data-reveal-line><span>No centro de</span></span>
        <span data-reveal-line><span>Cruz das Almas.</span></span>
      </h2>
      <p class="lede" data-reveal>
        {endereco.referencia.charAt(0).toUpperCase() + endereco.referencia.slice(1)}. Fácil
        de chegar a pé, de moto ou de carro — e aberto quando você chegar.
      </p>
    </div>

    <div class="local">
      <div class="local__info" data-reveal>
        <div class="local__bloco">
          <p class="eyebrow">Endereço</p>
          <p>
            {endereco.rua}<br />
            {endereco.bairro} — {endereco.cidade} – {endereco.uf}<br />
            CEP {endereco.cep}
          </p>
        </div>
        <div class="local__bloco">
          <p class="eyebrow">Horário</p>
          <p>{negocio.horario}</p>
        </div>
        <div class="local__bloco">
          <p class="eyebrow">Contato</p>
          <p>
            <a href={whatsappPadrao} target="_blank" rel="noopener">{negocio.telefone}</a>
          </p>
        </div>
        <div class="local__ctas">
          <a class="btn btn--primary" href={whatsappPadrao} target="_blank" rel="noopener">
            Falar no WhatsApp
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={negocio.mapsLink} target="_blank" rel="noopener">
            Traçar rota
          </a>
        </div>
      </div>

      <div class="local__mapa" data-reveal data-reveal-delay="0.1">
        <iframe
          src={negocio.mapsEmbed}
          title={`Mapa — ${negocio.nome}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .local {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .local {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2rem;
    }
  }

  .local__info {
    display: grid;
    align-content: start;
    gap: 1.75rem;
    padding: 2rem 1.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
  }

  .local__bloco {
    display: grid;
    gap: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .local__bloco a:hover {
    color: var(--brand-green);
  }

  .local__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .local__mapa {
    min-height: 22rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .local__mapa iframe {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    border: 0;
    filter: grayscale(0.6) invert(0.92) contrast(0.9);
  }
</style>
