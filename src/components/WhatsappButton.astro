---
import { negocio, whatsappPadrao } from '../data/conteudo';

// Glifo oficial do WhatsApp: ocupa exatamente 0–24 no viewBox e é preenchido
// (fill), então não sobra traço para estourar a caixa e ser cortado.
const whatsIcon =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z';
---

<!-- Desktop: botão flutuante -->
<a
  class="wa-float"
  href={whatsappPadrao}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={whatsIcon}></path>
  </svg>
  <span>WhatsApp</span>
</a>

<!-- Mobile: barra fixa com ligar + WhatsApp -->
<div class="wa-bar">
  <a class="wa-bar__btn wa-bar__btn--call" href={`tel:+${negocio.whatsappNumero}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path
        d="M5 3h3l1.6 4-2 1.4a12 12 0 0 0 5.9 5.9l1.4-2 4 1.6v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 5.2 2 2 0 0 1 5 3Z"
      ></path>
    </svg>
    Ligar
  </a>
  <a class="wa-bar__btn wa-bar__btn--wa" href={whatsappPadrao} target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={whatsIcon}></path>
    </svg>
    WhatsApp
  </a>
</div>

<style>
  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 80;
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--brand-green);
    color: var(--ink-dark);
    font-weight: 700;
    font-size: 0.875rem;
    box-shadow: 0 0.75rem 2rem -0.5rem rgba(147, 188, 30, 0.5);
    animation: wa-pulse 3s var(--ease-in-out) infinite;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .wa-float svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes wa-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.045);
    }
  }

  .wa-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 1px;
    background: var(--hairline);
    border-top: 1px solid var(--hairline);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .wa-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .wa-bar__btn svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .wa-bar__btn--call {
    background: var(--bg-elevated);
    color: var(--ink);
  }

  .wa-bar__btn--wa {
    background: var(--brand-green);
    color: var(--ink-dark);
  }

  :global(body) {
    padding-bottom: 3.25rem;
  }

  @media (min-width: 769px) {
    .wa-float {
      display: inline-flex;
    }
    .wa-bar {
      display: none;
    }
    :global(body) {
      padding-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
  }
</style>
